VITE_API_URL=http://localhost:8000
// Example using fetch
const fetchData = async () => {
  try {
    const response = await `${process.env.NEXT_PUBLIC_API_URL}/api/endpoint`;
    const data = await response.json();
    console.log(data);
  } catch (error) {
    console.error("Error connecting to backend:", error);
  }
};